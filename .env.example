# SQL Server
RACEDAY_DB_PASSWORD=ReplaceWithYourStrongSqlPassword123!

# JWT Authentication
# Use a randomly generated secret of at least 32 characters.
RACEDAY_JWT_KEY=ReplaceWithYourOwnRandomJwtSecretKeyAtLeast32Characters

# Azure Blob Storage
# Paste your Azure Storage connection string locally.
RACEDAY_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net